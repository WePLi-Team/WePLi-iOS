<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- DEC-015 잠금화면 위젯과 앱이 함께 쓰는 저장소 — Apple Developer에 같은 App Group 등록 필요 -->
